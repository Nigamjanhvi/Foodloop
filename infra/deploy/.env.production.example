# Copy to /opt/foodloop/config/.env.production on EC2; never commit the real file.
# ECR_REGISTRY must be ACCOUNT_ID.dkr.ecr.ap-south-1.amazonaws.com.
ECR_REGISTRY=000000000000.dkr.ecr.ap-south-1.amazonaws.com
IMAGE_TAG=replace-with-a-unique-release-tag

# Set a DNS name whose A/AAAA record points to this EC2 instance.
FOODLOOP_DOMAIN=foodloop.example.com
CORS_ORIGIN=https://foodloop.example.com

POSTGRES_DB=foodloop
POSTGRES_USER=foodloop
# Generate a strong URL-safe random value. Avoid URI-reserved characters because
# the application DATABASE_URL is assembled from these PostgreSQL fields.
POSTGRES_PASSWORD=replace-with-a-unique-url-safe-secret

# Generate at least 32 random bytes; JWT signing secret is never sent to frontend.
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRES_IN=8h

# Nodemailer worker requires SMTP_HOST, SMTP_PORT, and SMTP_FROM and verifies
# this connection before it becomes healthy. Use relay credentials as required.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=FoodLoop <notifications@example.com>
SMTP_MESSAGE_DOMAIN=example.com

NOTIFICATION_POLL_MS=2000
NOTIFICATION_MAX_ATTEMPTS=8
NOTIFICATION_RETRY_BASE_MS=5000
# Generate 32 random bytes and base64-encode them for OTP email payload encryption.
NOTIFICATION_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# One-time admin bootstrap only. Keep these in a separate ignored file and
# inject them only into `npm run db:seed-admin`; do not uncomment here.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-16-characters
# ADMIN_FULL_NAME=FoodLoop Administrator
# ADMIN_PHONE=+911234567890
