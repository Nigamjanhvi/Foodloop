NODE_ENV=development
PORT=4000
POSTGRES_DB=foodloop
POSTGRES_USER=foodloop
POSTGRES_PASSWORD=foodloop_dev_password
FOODLOOP_DB_HOST_PORT=5434
DATABASE_URL=postgres://foodloop:foodloop_dev_password@localhost:5434/foodloop
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=8h
# Local admin bootstrap placeholders. Never commit real credentials.
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME=FoodLoop Administrator
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-16-characters
ADMIN_PHONE=+911234567890
# Independent email worker. Use real SMTP credentials only in an untracked .env.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FoodLoop <notifications@example.invalid>
SMTP_MESSAGE_DOMAIN=localhost
NOTIFICATION_POLL_MS=2000
NOTIFICATION_MAX_ATTEMPTS=8
NOTIFICATION_RETRY_BASE_MS=5000
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
NOTIFICATION_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
ADMIN_NOTIFICATION_EMAIL=
# Optional Docker host ports. Set the frontend port consistently with CORS_ORIGIN.
FOODLOOP_FRONTEND_HOST_PORT=5173
FOODLOOP_API_HOST_PORT=4000
